# Runtime connection. On Neon, use the pooled connection string.
DATABASE_URL="postgresql://homepros:homepros@localhost:5432/homepros?schema=public"

# Direct connection for Prisma migrations. On Neon, use the non-pooled string.
# Locally this can match DATABASE_URL.
DIRECT_URL="postgresql://homepros:homepros@localhost:5432/homepros?schema=public"

# Signs session cookies. Use a long random value in production (32+ characters).
AUTH_SECRET="replace-with-a-long-random-string"

# Public site URL. Placeholder until the real Cartley domain is chosen.
NEXT_PUBLIC_SITE_URL="https://homepros.cartley.com"

# Email. Leave RESEND_API_KEY empty in local dev to log messages in the console.
EMAIL_FROM="HomePros <leads@homepros.cartley.com>"
RESEND_API_KEY=""

# Optional pixel hooks. When unset, events still push to dataLayer, gtag, and fbq if those exist.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
